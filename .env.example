# Copy to .env and run: npm run start:env
PORT=3000
# Public https URL of your deployment (used in tracking links). Optional locally.
PUBLIC_URL=
# Real SMS via Twilio (leave blank to simulate; messages are printed in the server console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional: POST alerts to a dispatcher/authority endpoint you are authorised to use
AUTHORITY_WEBHOOK=
VOLUNTEER_RADIUS_KM=5
